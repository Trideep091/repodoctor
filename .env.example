# ==============================================================================
# Repo Doctor — Environment Variables Template
# Copy this file to .env and configure your credentials.
# NEVER commit your actual .env or *.pem files to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GitHub App Authentication (Recommended & Multi-Tenant Ready)
# ------------------------------------------------------------------------------
# Numeric App ID from your GitHub App general settings (e.g. 5406515)
# This stays the SAME for all users and across all environments (local & deployed).
GITHUB_APP_ID=

# GitHub App Slug (optional - automatically resolved via GitHub API if omitted):
# GITHUB_APP_SLUG=repodoctor-trideep

# FOR LOCAL DEVELOPMENT: Path to the downloaded private key file (.pem)
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem

# FOR CLOUD DEPLOYMENT (Vercel, Render, Railway, etc.):
# Set this in your cloud platform's Environment Variables dashboard.
# Paste the full RSA private key content (with newlines or \n, or Base64 encoded).
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ⚠️ CRITICAL DEPLOYMENT NOTE FOR GITHUB_APP_INSTALLATION_ID:
# LEAVE THIS EMPTY OR OMITTED IN PRODUCTION DEPLOYMENTS!
# Each user who installs your GitHub App on their account receives their OWN
# unique Installation ID. Repo Doctor dynamically discovers each user's installation ID
# via the GitHub API (GET /repos/:owner/:repo/installation) so ANY user can use the app.
# GITHUB_APP_INSTALLATION_ID=

# ------------------------------------------------------------------------------
# 2. GitHub Personal Access Token (PAT) — Optional / Fallback
# ------------------------------------------------------------------------------
# Classic or Fine-Grained token with "repo" write scope
# GITHUB_TOKEN=ghp_your_token_here

# ------------------------------------------------------------------------------
# 3. AI Providers (Optional - Deterministic Context Engine Active by Default)
# ------------------------------------------------------------------------------
AI_PROVIDER=deterministic
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Server Configuration
# ------------------------------------------------------------------------------
PORT=5001
