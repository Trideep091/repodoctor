# ==============================================================================
# Repo Doctor — Environment Variables Template
# Copy this file to .env and configure your credentials.
# NEVER commit your actual .env or *.pem files to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GitHub App Authentication (Recommended)
# ------------------------------------------------------------------------------
# Numeric App ID from your GitHub App general settings (e.g. 1234567)
GITHUB_APP_ID=

# Path to the downloaded private key file (.pem)
# Recommended for local development to avoid multiline string issues:
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem

# OR provide the raw PEM key directly (useful in cloud/container environments):
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Optional: Specify an explicit Installation ID if desired.
# If omitted, Repo Doctor dynamically resolves the installation ID for each repo.
# GITHUB_APP_INSTALLATION_ID=

# ------------------------------------------------------------------------------
# 2. GitHub Personal Access Token (PAT) — Optional / Fallback
# ------------------------------------------------------------------------------
# Classic or Fine-Grained token with "repo" write scope
# GITHUB_TOKEN=ghp_your_token_here

# ------------------------------------------------------------------------------
# 3. AI Providers (Optional - Deterministic Context Engine Active by Default)
# ------------------------------------------------------------------------------
AI_PROVIDER=deterministic
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Server Configuration
# ------------------------------------------------------------------------------
PORT=5001
