{
  "name": "repo-doctor",
  "version": "1.0.0",
  "description": "Full-Stack AI-Powered GitHub Repository Diagnosis, Security, Repair and Pull Request Platform",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspace=server"
  },
  "devDependencies": {
    "@vercel/node": "^26.0.0",
    "concurrently": "^9.1.2"
  }
}
