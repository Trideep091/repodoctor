{
  "name": "repo-doctor",
  "version": "1.0.0",
  "description": "Full-Stack AI-Powered GitHub Repository Diagnosis, Security, Repair and Pull Request Platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspace=server"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-levenshtein": "^3.0.0"
  },
  "devDependencies": {
    "@vercel/node": "^26.0.0",
    "concurrently": "^9.1.2"
  }
}
